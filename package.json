{
  "name": "vc-ve-tools",
  "displayName": "Восточный Экспресс расширение",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "ve-pkf",
        "aliases": [
          "PKF",
          "pkf"
        ],
        "extensions": [
          ".pkf"
        ],
        "configuration": "./syntaxes/pkf-language-configuration.json"
      },
      {
        "id": "ve-pascal",
        "aliases": [
          "Pascal/Delphi",
          "Pascal",
          "Delphi"
        ],
        "extensions": [
          ".pas"
        ],
        "configuration": "./syntaxes/pascal-language-configuration.json"
      },
      {
        "id": "ve-dfm",
        "aliases": [
          "DFM",
          "Delphi Form"
        ],
        "extensions": [
          ".dfm"
        ],
        "configuration": "./syntaxes/dfm-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ve-pkf",
        "scopeName": "source.pkf",
        "path": "./syntaxes/pkf.tmLanguage.json"
      },
      {
        "language": "ve-pascal",
        "scopeName": "source.pascal.delphi",
        "path": "./syntaxes/pascal.tmLanguage.json"
      },
      {
        "language": "ve-dfm",
        "scopeName": "source.dfm",
        "path": "./syntaxes/dfm.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Восточный Экспресс",
      "properties": {
        "vcVeTools.useFolderAsProjectRoot": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "description": "Использовать открытую папку как корень проекта и читать PKF, Pascal и BAT-файлы в Windows-1251."
        },
        "vcVeTools.databaseRole": {
          "type": "string",
          "enum": [
            "main",
            "test"
          ],
          "enumDescriptions": [
            "Основная база из devDBName_main.",
            "Тестовая база из devDBName_test."
          ],
          "default": "main",
          "scope": "window",
          "description": "База данных, к которой подключается Восточный Экспресс."
        },
        "vcVeTools.databaseProfile": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Секция базы данных из trunk\\bin\\rdboadm.ini. Пустое значение выбирает первую секцию."
        },
        "vcVeTools.userId": {
          "type": "number",
          "default": 0,
          "scope": "window",
          "description": "ID пользователя в системе Восточного Экспресса для логирования изменений методов."
        },
        "vcVeTools.clientUsername": {
          "type": "string",
          "default": "",
          "scope": "window",
          "description": "Логин пользователя для запуска оригинального клиента Восточного Экспресса."
        },
        "vcVeTools.mcp.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "description": "Включить MCP-сервер для AI-агентов. Прямые SQL-запросы доступны только для чтения; код методов можно изменять через контролируемый инструмент сохранения."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vc-ve-tools",
          "title": "Восточный Экспресс",
          "icon": "resources/train.svg"
        }
      ],
      "panel": [
        {
          "id": "vc-ve-tools-sql-tools",
          "title": "Исполнитель SQL",
          "icon": "resources/train.svg"
        },
        {
          "id": "vc-ve-tools-code-history",
          "title": "История кода",
          "icon": "resources/train.svg"
        }
      ]
    },
    "views": {
      "vc-ve-tools": [
        {
          "id": "vc-ve-tools.explorer",
          "name": "Проводник",
          "type": "webview"
        }
      ],
      "vc-ve-tools-sql-tools": [
        {
          "id": "vc-ve-tools.sqlExecutor",
          "name": "Исполнитель SQL",
          "type": "webview"
        }
      ],
      "vc-ve-tools-code-history": [
        {
          "id": "vc-ve-tools.codeHistory",
          "name": "История кода",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "vc-ve-tools.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "vc-ve-tools.testDatabaseConnection",
        "title": "Восточный Экспресс: Проверить подключение к базе"
      },
      {
        "command": "vc-ve-tools.selectDatabaseRole",
        "title": "Восточный Экспресс: Выбрать базу данных"
      },
      {
        "command": "vc-ve-tools.setUserId",
        "title": "Восточный Экспресс: Установить ID пользователя"
      },
      {
        "command": "vc-ve-tools.openSqlMonitor",
        "title": "SQL-монитор",
        "category": "Восточный экспресс",
        "icon": "$(database)"
      },
      {
        "command": "vc-ve-tools.openPackageSync",
        "title": "Синхронизация проектов",
        "category": "Восточный экспресс",
        "icon": "$(sync)"
      },
      {
        "command": "vc-ve-tools.openSettings",
        "title": "Настройки",
        "category": "Восточный экспресс",
        "icon": "$(settings-gear)"
      },
      {
        "command": "vc-ve-tools.updateMainDatabase",
        "title": "Обновить основную базу",
        "category": "Восточный экспресс"
      },
      {
        "command": "vc-ve-tools.updateTestDatabase",
        "title": "Обновить тестовую базу",
        "category": "Восточный экспресс"
      },
      {
        "command": "vc-ve-tools.startMainClient",
        "title": "Запустить клиент — основная база",
        "category": "Восточный экспресс"
      },
      {
        "command": "vc-ve-tools.startTestClient",
        "title": "Запустить клиент — тестовая база",
        "category": "Восточный экспресс"
      },
      {
        "command": "vc-ve-tools.copySelectedExplorerId",
        "title": "Восточный Экспресс: Копировать ID выделенного объекта"
      },
      {
        "command": "vc-ve-tools.installAgentSkills",
        "title": "Восточный Экспресс: Установить навыки для ИИ-агентов"
      },
      {
        "command": "vc-ve-tools.showSelectionHistory",
        "title": "История выделенного кода",
        "category": "Восточный Экспресс"
      },
      {
        "command": "vc-ve-tools.showCodeHistory",
        "title": "История файла или метода",
        "category": "Восточный Экспресс"
      },
      {
        "command": "vc-ve-tools.svnLocalDiff",
        "title": "Local Diff",
        "category": "SVN"
      },
      {
        "command": "vc-ve-tools.svnHistory",
        "title": "История файла",
        "category": "SVN"
      },
      {
        "command": "vc-ve-tools.svnBlame",
        "title": "Blame",
        "category": "SVN"
      }
    ],
    "submenus": [
      {
        "id": "vc-ve-tools.svnMenu",
        "label": "SVN"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "vc-ve-tools.svnMenu",
          "when": "editorTextFocus && (resourceScheme == file || resourceScheme == 'vc-ve-method')",
          "group": "navigation@19"
        },
        {
          "command": "vc-ve-tools.showSelectionHistory",
          "when": "editorTextFocus && editorHasSelection && (resourceScheme == file || resourceScheme == 'vc-ve-method')",
          "group": "navigation@20"
        },
        {
          "command": "vc-ve-tools.showCodeHistory",
          "when": "editorTextFocus && (resourceScheme == file || resourceScheme == 'vc-ve-method')",
          "group": "navigation@21"
        }
      ],
      "vc-ve-tools.svnMenu": [
        {
          "command": "vc-ve-tools.svnLocalDiff",
          "group": "1_compare@1"
        },
        {
          "command": "vc-ve-tools.svnHistory",
          "group": "2_history@1"
        },
        {
          "command": "vc-ve-tools.svnBlame",
          "group": "2_history@2"
        }
      ],
      "view/title": [
        {
          "command": "vc-ve-tools.openSqlMonitor",
          "when": "view == vc-ve-tools.explorer",
          "group": "navigation@1"
        },
        {
          "command": "vc-ve-tools.openPackageSync",
          "when": "view == vc-ve-tools.explorer",
          "group": "navigation@2"
        },
        {
          "command": "vc-ve-tools.openSettings",
          "when": "view == vc-ve-tools.explorer",
          "group": "navigation@3"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "vc-ve-tools.database",
        "label": "East Express Database"
      }
    ],
    "languageModelTools": [
      {
        "name": "vcVeTools_reveal_class",
        "tags": [
          "east-express",
          "navigation",
          "classes"
        ],
        "toolReferenceName": "veRevealClass",
        "displayName": "Показать класс Восточного Экспресса",
        "modelDescription": "Reveal an East Express class in the vc-ve-tools Explorer. Use a classId returned by the vc-ve-tools MCP search_classes tool.",
        "userDescription": "Показывает найденный класс в проводнике расширения.",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-tree)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "classId": {
              "type": "integer",
              "minimum": 1,
              "description": "ID класса Восточного Экспресса"
            }
          },
          "required": [
            "classId"
          ]
        }
      },
      {
        "name": "vcVeTools_open_class",
        "tags": [
          "east-express",
          "navigation",
          "classes"
        ],
        "toolReferenceName": "veOpenClass",
        "displayName": "Открыть класс Восточного Экспресса",
        "modelDescription": "Reveal an East Express class in the vc-ve-tools Explorer and open its details panel. Use a classId returned by the vc-ve-tools MCP search_classes tool.",
        "userDescription": "Показывает класс в проводнике и открывает его карточку.",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-class)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "classId": {
              "type": "integer",
              "minimum": 1,
              "description": "ID класса Восточного Экспресса"
            }
          },
          "required": [
            "classId"
          ]
        }
      },
      {
        "name": "vcVeTools_open_method",
        "tags": [
          "east-express",
          "navigation",
          "methods"
        ],
        "toolReferenceName": "veOpenMethod",
        "displayName": "Открыть метод Восточного Экспресса",
        "modelDescription": "Open an East Express database method in the VS Code virtual editor. Use a methodId returned by the vc-ve-tools MCP search_methods tool.",
        "userDescription": "Открывает найденный метод в редакторе VS Code.",
        "canBeReferencedInPrompt": true,
        "icon": "$(symbol-method)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "methodId": {
              "type": "integer",
              "minimum": 1,
              "description": "ID метода Восточного Экспресса"
            }
          },
          "required": [
            "methodId"
          ]
        }
      },
      {
        "name": "vcVeTools_reveal_method",
        "tags": [
          "east-express",
          "navigation",
          "methods",
          "classes"
        ],
        "toolReferenceName": "veRevealMethod",
        "displayName": "Показать метод в карточке класса",
        "modelDescription": "Open an East Express class card, switch to the Methods tab, select an exact method row, and scroll it into view without cursor automation.",
        "userDescription": "Открывает вкладку методов класса и выделяет указанный метод.",
        "canBeReferencedInPrompt": true,
        "icon": "$(list-selection)",
        "inputSchema": {
          "type": "object",
          "properties": {
            "classId": {
              "type": "integer",
              "minimum": 1,
              "description": "ID класса-владельца"
            },
            "methodId": {
              "type": "integer",
              "minimum": 1,
              "description": "ID метода"
            }
          },
          "required": [
            "classId",
            "methodId"
          ]
        }
      }
    ],
    "keybindings": [
      {
        "command": "vc-ve-tools.openSqlMonitor",
        "key": "alt+shift+i"
      },
      {
        "command": "vc-ve-tools.copySelectedExplorerId",
        "key": "ctrl+c",
        "when": "vcVeTools.explorerCopyContext"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run build:webview && node esbuild.js",
    "build:webview": "vue-tsc -p webview-ui/tsconfig.json --noEmit && vite build --config vite.webview.config.mts --mode explorer && vite build --config vite.webview.config.mts --mode package-sync && vite build --config vite.webview.config.mts --mode class-details && vite build --config vite.webview.config.mts --mode class-objects && vite build --config vite.webview.config.mts --mode object-view && vite build --config vite.webview.config.mts --mode attribute-details && vite build --config vite.webview.config.mts --mode property-details && vite build --config vite.webview.config.mts --mode entity-properties && vite build --config vite.webview.config.mts --mode sql-monitor && vite build --config vite.webview.config.mts --mode sql-executor && vite build --config vite.webview.config.mts --mode code-history && vite build --config vite.webview.config.mts --mode settings",
    "watch": "npm-run-all -p watch:*",
    "watch:webview": "vite build --watch --config vite.webview.config.mts",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run build:webview && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pg": "^8.23.1",
    "@types/vscode": "^1.134.0",
    "@types/web-bluetooth": "^0.0.21",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.2.2",
    "vue-component-type-helpers": "^3.3.11",
    "vue-tsc": "^3.3.11"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/vue": "^1.0.8",
    "@lucide/vue": "^1.39.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "iconv-lite": "^0.7.3",
    "node-pty": "^1.1.0",
    "pg": "^8.23.0",
    "reka-ui": "^2.10.4",
    "shadcn-vue": "^2.8.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.42",
    "zod": "^3.25.76"
  }
}
