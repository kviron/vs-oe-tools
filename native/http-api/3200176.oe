procedure(aHttpMethodParams: String);

 // Both transports supply parameters[].name/value to the shared executor.
 function MatchesParameter(aGivenName, aParameterName: String): Boolean;
 begin
  Result := (LCase(aGivenName) = LCase(aParameterName)) or
   (LCase(aGivenName) = LCase(aParameterName + '.json'));
 end;

 procedure ValidateParameterNames(aRequest: wDynamicStorage; aHandler: Метод);
 begin
  for var requestIndex := 0 to aRequest.Count('parameters') - 1 do
  begin
   var givenName := ToStr(aRequest.ReadFmt('parameters[%*].name', requestIndex));
   var knownParameter := false;
   for var parameterIndex := 0 to aHandler.ParamCount - 1 do
    if MatchesParameter(givenName, aHandler.ParamName(parameterIndex)) then
     knownParameter := true;
   Assert(knownParameter, 'Неизвестный параметр: ' + givenName);
  end;
 end;

 function CreateApiParameter(aJson: String; aRetainedObjects: Абстракт[]): APIПараметр;
 begin
  var parameter := APIПараметр.Create;
  var fields := wDynamicStorage.CreateByJsonString(aJson);
  Assert(fields.IsObject(''), 'APIПараметр должен быть JSON-объектом');
  for var fieldIndex := 0 to fields.Count('') - 1 do
  begin
   var fieldName := fields.GetNameFmt('[%*]', fieldIndex);
   var attribute := parameter.АтрибутПоИмени(fieldName, true);
   Assert(attribute.SeniorID = APIПараметр, 'Недопустимое поле APIПараметр: ' + fieldName);
   var valueClass := attribute.ОбщийКлассЗначений();
   var fieldValue := fields.Read(fieldName);
   if valueClass = wDynamicStorage then
   begin
    var nestedStorage := wDynamicStorage.CreateByJsonString(ToStr(fieldValue));
    aRetainedObjects.Append(nestedStorage);
    fieldValue := nestedStorage;
   end else
    fieldValue := Функции_мат.ПреобразоватьЗначениеПоТипу(
     attribute.ТипАтр, fieldValue, valueClass, aRetainedObjects);
   parameter.SetAttrValuesByName(fieldName, fieldValue);
  end;
  aRetainedObjects.Append(parameter);
  Result := parameter;
 end;

 function ConvertParameter(aHandler: Метод; aIndex: Integer; aValue: String;
  aIsJson: Boolean; aRetainedObjects: Абстракт[]): Variant;
 begin
  var parameterClass := aHandler.ParamClass(aIndex);
  if Assigned(parameterClass) then
   aIsJson := aIsJson or parameterClass.InheritsFromClass(wDynamicStorage);
  if not aIsJson then
  begin
   Result := Функции_мат.ПреобразоватьЗначениеПоТипу(
    aHandler.ParamType(aIndex), aValue, parameterClass, aRetainedObjects);
   Exit;
  end;
  if parameterClass = APIПараметр then
  begin
   Result := CreateApiParameter(aValue, aRetainedObjects);
   Exit;
  end;
  Assert(Assigned(parameterClass) and parameterClass.InheritsFromClass(wDynamicStorage),
   'Параметр не поддерживает JSON: ' + aHandler.ParamName(aIndex));
  var storage := wDynamicStorage.CreateByJsonString(aValue);
  aRetainedObjects.Append(storage);
  Result := storage;
 end;

 function BuildArguments(aRequest: wDynamicStorage; aHandler: Метод;
  aRetainedObjects: Абстракт[]): Variant;
 begin
  ValidateParameterNames(aRequest, aHandler);
  var arguments := VarArrayCreate(0, aHandler.ParamCount - 1);
  for var parameterIndex := 0 to aHandler.ParamCount - 1 do
  begin
   var parameterName := aHandler.ParamName(parameterIndex);
   var parameterClass := aHandler.ParamClass(parameterIndex);
   if Assigned(parameterClass) then
    Assert(not parameterClass.InheritsFromClass(HttpDataStream),
     'Параметр ' + parameterName + ': HttpDataStream требует HTTP. Метод не вызван.');
   var found := false;
   var value := '';
   var isJson := false;
   for var requestIndex := 0 to aRequest.Count('parameters') - 1 do
   begin
    var givenName := ToStr(aRequest.ReadFmt('parameters[%*].name', requestIndex));
    if MatchesParameter(givenName, parameterName) then
    begin
     Assert(not found, 'Параметр передан дважды: ' + parameterName);
     found := true;
     value := ToStr(aRequest.ReadFmt('parameters[%*].value', requestIndex));
     isJson := LCase(givenName) = LCase(parameterName + '.json');
    end;
   end;
   if found then
    arguments[parameterIndex] := ConvertParameter(aHandler, parameterIndex, value, isJson, aRetainedObjects)
   else
   begin
    Assert(aHandler.ParamIsDefault(parameterIndex), 'Не указан обязательный параметр: ' + parameterName);
    arguments[parameterIndex] := aHandler.ParamDefVal(parameterIndex, aRetainedObjects);
   end;
  end;
  Result := arguments;
 end;

 procedure WriteResult(aBody: wDynamicStorage; aPath: String; aHandler: Метод; aValue: Variant);
 begin
  var resultClass := aHandler.ResultClass;
  if Assigned(resultClass) and VarIsInt(aValue) and (ToRoid(aValue) <> 0) then
  begin
   if resultClass.InheritsFromClass(wDynamicStorage) then
   begin
    aBody.WriteJson(aPath, wDynamicStorage(ToRoid(aValue)).AsJsonString);
    Exit;
   end;
   if resultClass.InheritsFromClass(wDataSet) then
   begin
    aBody.WriteJson(aPath, wDataSet(ToRoid(aValue)).AsJsonString);
    Exit;
   end;
  end;
  aBody.Write(aPath, aValue);
 end;

 // Keep temporary objects alive through invocation and result serialization.
 function ExecuteHandler(aMethodName: String; aRequest: wDynamicStorage;
  aWrapResult: Boolean): wDynamicStorage;
 begin
  var httpMethod := RDBOHTTPServer.TryGetHttpMethod(aMethodName);
  Assert(Assigned(httpMethod), 'HTTP-метод не найден: ' + aMethodName);
  var handler := httpMethod.Метод;
  Assert(Assigned(handler), 'Не задан обработчик HTTP-метода');
  if Assigned(handler.ResultClass) then
   Assert(not handler.ResultClass.InheritsFromClass(HttpDataStream),
    'Результат HttpDataStream требует HTTP. Метод не вызван.');
  var retainedObjects := Абстракт[].Create;
  var arguments := BuildArguments(aRequest, handler, retainedObjects);
  var body := wDynamicStorage.Create;
  var resultPath := '';
  if aWrapResult then resultPath := 'result';

  // The template handler otherwise reads a missing current-HTTP-method context.
  if handler = Метод(10893298) then
  begin
   Assert(httpMethod is HttpМетодПоШаблону, 'Обработчику шаблона нужен объект HttpМетодПоШаблону');
   var query := HttpМетодПоШаблону(httpMethod).РассчитатьПоШаблону(APIПараметр(ToRoid(arguments[0])));
   body.WriteJson(resultPath, query.AsJsonString);
  end else
  begin
   var handlerResult := handler.Invoke(handler.SeniorID, arguments);
   WriteResult(body, resultPath, handler, handlerResult);
  end;
  if aWrapResult then
   for var parameterIndex := 0 to handler.ParamCount - 1 do
    if handler.ParamIsRef(parameterIndex) then
     body.Write('outParameters.' + handler.ParamName(parameterIndex), arguments[parameterIndex]);
  Result := body;
 end;

 procedure ExecuteDirect(aMethodName, aRequestFile, aResponseFile: String);
 begin
  var envelope := wDynamicStorage.Create;
  envelope.Write('protocol', 'vcve-direct-v1');
  try
   var request := wDynamicStorage.CreateByJsonString(wStringList.CreateByFile(aRequestFile).Text);
   Assert(ToStr(request.Read('protocol')) = 'vcve-direct-v1', 'Несовместимая версия запроса');
   Assert(ToStr(request.Read('methodName')) = aMethodName, 'Имя метода в запросе не совпадает с выбранным');
   var body := ExecuteHandler(aMethodName, request, true);
   envelope.Write('ok', true);
   envelope.Write('body', body.AsJsonString);
  except
   envelope.Write('ok', false);
   envelope.Write('error', ExceptionMessage());
  end;
  var output := wFileStream.CreateFileStream(aResponseFile, enumFileMode.Creation, enumFileShare.Exclusive);
  try
   envelope.ToJsonStreamAsUTF8(output);
  finally
   output.Close;
  end;
 end;

 function ReadHttpParameters(aListener: wHttpListener; aHandler: Метод): wDynamicStorage;
 begin
  var request := wDynamicStorage.Create;
  request.WriteEmptyArray('parameters');
  for var parameterIndex := 0 to aHandler.ParamCount - 1 do
  begin
   var parameterName := aHandler.ParamName(parameterIndex);
   var value := aListener.CurrentRequestParamValueByName(parameterName + '.json');
   if value <> '' then
    parameterName := parameterName + '.json'
   else
    value := aListener.CurrentRequestParamValueByName(parameterName);
   // Legacy listener semantics: an empty value is still treated as omitted.
   if value <> '' then
   begin
    var requestIndex := request.Count('parameters');
    var parameterPath := 'parameters[' + ToStr(requestIndex) + ']';
    request.Write(parameterPath + '.name', parameterName);
    request.Write(parameterPath + '.value', value);
   end;
  end;
  Result := request;
 end;

 procedure RespondToHttpRequest(aListener: wHttpListener; aAllowedMethodName: String);
 begin
  var statusCode := 200;
  var statusText := 'OK';
  var responseBody := '';
  try
   if aListener.CurrentRequestPath <> '/api' then
   begin
    statusCode := 404;
    statusText := 'Not Found';
    responseBody := '{"error":"Unknown endpoint"}';
   end else
   begin
    var methodName := aListener.CurrentRequestParamValueByName('method');
    Assert(methodName <> '', 'Не задан параметр method');
    if aAllowedMethodName <> '*' then
     Assert(UCase(methodName) = UCase(aAllowedMethodName),
      'Метод не разрешен тестовым сервером: ' + SingleQuoteStr(methodName));
    var httpMethod := RDBOHTTPServer.TryGetHttpMethod(methodName);
    Assert(Assigned(httpMethod), 'HTTP-метод не найден: ' + methodName);
    var handler := httpMethod.Метод;
    Assert(Assigned(handler), 'Не задан обработчик HTTP-метода');
    var request := ReadHttpParameters(aListener, handler);
    var body := ExecuteHandler(methodName, request, false);
    responseBody := body.AsJsonString;
   end;
  except
   statusCode := 500;
   statusText := 'Internal Server Error';
   var errorBody := wDynamicStorage.Create;
   errorBody.Write('error', ExceptionMessage());
   responseBody := errorBody.AsJsonString;
  end;
  aListener.Respond(statusCode, statusText, 'application/json; charset=utf-8', responseBody);
 end;

 procedure RunHttpServer(aMethodName: String);
 begin
  Assert(aMethodName <> '', 'Не задано имя HTTP-метода');
  var serverUrl := 'http://127.0.0.1:18081/api';
  var listener := wHttpListener.Create;
  listener.AddUrlPrefix('http://127.0.0.1:18081/');
  SysUtils.WriteLn('VCVE_HTTP_URL=' + serverUrl);
  FileUtils.SaveStringToFile(serverUrl, 'vcve_http_url.txt');
  while Assigned(listener) do
   if listener.TryGetRequest(100) then
    RespondToHttpRequest(listener, aMethodName);
 end;

 procedure CheckDeveloperAccess(aUsername: String);
 begin
  // Preserve the launch contract; session-based authorization needs separate verification.
  Assert(aUsername <> '', 'Не задан логин пользователя');
  var developerCount := ToInt(RAT.EvalQuery(
   sqltext!
    select count(1)
    from GETUSERSBYROLE(12851160) role_user
    join Users app_user on app_user.ID = role_user.ID
    where lower(app_user.Name) = &LCase(aUsername)&
   !end
  ));
  Assert(developerCount > 0,
   'Запуск тестового HTTP-сервера разрешён только пользователю с ролью Разработчик');
 end;

begin
 var methodName := ToStr(ParamListGet(aHttpMethodParams, 'method'));
 var username := ToStr(ParamListGet(aHttpMethodParams, 'username'));
 CheckDeveloperAccess(username);
 var requestFile := ToStr(ParamListGet(aHttpMethodParams, 'requestFile'));
 if requestFile <> '' then
 begin
  var responseFile := ToStr(ParamListGet(aHttpMethodParams, 'responseFile'));
  Assert(responseFile <> '', 'Не задан файл результата прямого вызова');
  ExecuteDirect(methodName, requestFile, responseFile);
 end else
  RunHttpServer(methodName);
end;
